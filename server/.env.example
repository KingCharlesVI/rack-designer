# Copy to .env and adjust. Generate a token with:  openssl rand -hex 24
ADMIN_TOKEN=change-me

# Name shown in Rack Designer and on the landing page
REGISTRY_NAME=Homelab rack packs

# false = uploads wait for approval in the admin console (/admin); true = publish immediately
AUTO_APPROVE=false

# false = read-only registry (packs can only be added with the import command)
ACCEPT_SUBMISSIONS=true

# Max uploads per client IP per hour
SUBMIT_RATE_LIMIT=20

# Set when running behind a reverse proxy (Caddy, nginx, Traefik) that adds X-Forwarded-* headers
TRUST_PROXY=false

# Public address shown on the landing page, e.g. https://racks.home.lan (optional)
PUBLIC_URL=
