{
  "name": "rack-designer",
  "version": "0.1.0",
  "description": "Desktop application for designing server racks, with a large component library and power/data connection modelling.",
  "main": "./out/main/index.js",
  "author": "KingCharlesVI",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pack": "electron-vite build && electron-builder --win --dir",
    "dist": "electron-vite build && electron-builder --win",
    "postinstall": "node node_modules/electron/install.js",
    "registry:check": "tsx scripts/registry.ts",
    "registry:build": "tsx scripts/registry.ts --write",
    "server:dev": "tsx server/src/main.ts",
    "server:build": "esbuild server/src/main.ts --bundle --platform=node --format=esm --target=node18 --outfile=server/dist/registry-server.mjs --legal-comments=none"
  },
  "dependencies": {
    "immer": "^11.2.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
